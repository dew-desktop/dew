---
/**
 * Every topic as a column of its pages, from the route's own sidebar. On a page
 * that belongs to no topic, the home page, `src/route-data.ts` leaves the sidebar
 * whole, so this lists exactly what the navigation does.
 *
 * A component rather than markup in the page: Starlight's route data exists only
 * once `StarlightPage` is rendering, which is when it renders this.
 */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type Entry = StarlightRouteData['sidebar'][number];
type Link = Extract<Entry, { type: 'link' }>;
const links = (entry: Entry): Link[] => (entry.type === 'link' ? [entry] : entry.entries.flatMap(links));

const topics = Astro.locals.starlightRoute.sidebar.filter((entry) => entry.type === 'group');
---

<div class="dew-topic-index">
	{
		topics.map((topic) => (
			<section>
				<h3>{topic.label}</h3>
				<ul>
					{links(topic).map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.dew-topic-index {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 2rem;
		margin-top: 1rem;
	}

	h3 {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li + li {
		margin-top: 0.5rem;
	}

	a {
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}
</style>

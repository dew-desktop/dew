---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TopicIndex from '../components/TopicIndex.astro';

/**
 * Stripe's home: a title and a lede, two ways in, then every topic as a column
 * of doors. `not-content` keeps the article styles off what is navigation.
 */
---

<StarlightPage
	frontmatter={{
		title: 'Dew documentation',
		description: 'Build apps in Luau, with the interface classes you know from Roblox.',
		template: 'splash',
	}}
>
	<div class="not-content">
		<div class="dew-home-actions">
			<a class="dew-button dew-button--primary" href="/get-started/quickstart/">Get started</a>
			<a class="dew-button" href="/applets/structure/">Learn about applets</a>
		</div>

		<h2 class="dew-home-heading">Explore the documentation</h2>
		<TopicIndex />
	</div>
</StarlightPage>

<style>
	.dew-home-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.dew-button {
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
	}

	.dew-button:hover {
		border-color: var(--sl-color-gray-4);
	}

	.dew-button--primary {
		border-color: var(--sl-color-accent);
		background-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	.dew-button--primary:hover {
		border-color: var(--sl-color-accent-high);
		background-color: var(--sl-color-accent-high);
	}

	.dew-home-heading {
		margin-top: 3.5rem;
		font-size: 1.25rem;
		font-weight: 650;
		color: var(--sl-color-white);
	}
</style>

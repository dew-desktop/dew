{
  "id": "timetracker",
  "name": "Time Tracker & Pomodoro HUD",
  "version": "1.0.0",
  "author": "Dew Core Team",
  "description": "Minimalist active time tracker, Pomodoro focus cycles, and task logger",
  "permissions": ["storage", "audio", "notifications"],
  "hotkeys": {
    "toggleActiveTimer": "Alt+Shift+T",
    "quickTaskLog": "Alt+Shift+L",
    "togglePomodoro": "Alt+Shift+P"
  },
  "settings": {
    "pomodoroWorkMin": {
      "type": "number",
      "label": "Pomodoro Work Duration (minutes)",
      "default": 25
    },
    "pomodoroBreakMin": {
      "type": "number",
      "label": "Pomodoro Short Break (minutes)",
      "default": 5
    },
    "dailyTargetHours": {
      "type": "number",
      "label": "Daily Goal Target (hours)",
      "default": 6
    },
    "soundEnabled": {
      "type": "boolean",
      "label": "Sound Chimes on Interval Finish",
      "default": true
    }
  }
}
